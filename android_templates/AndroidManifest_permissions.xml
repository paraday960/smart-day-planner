<!-- ═══════════════════════════════════════════════════════════════════
     AndroidManifest کامل — مرجع نهایی
     محل استفاده: android/app/src/main/AndroidManifest.xml
     (این فایل با flutter create ساخته می‌شود؛ permissionها را از اینجا بردار)
     ═══════════════════════════════════════════════════════════════════ -->

<!-- دسترسی‌های موردنیاز برنامه -->
<uses-permission android:name="android.permission.INTERNET"/>
<!-- تشخیص گفتار سرویس گوشی ممکن است آنلاین باشد -->

<uses-permission android:name="android.permission.RECORD_AUDIO"/>
<!-- فرمان صوتی فارسی -->

<uses-permission android:name="android.permission.READ_CALENDAR"/>
<uses-permission android:name="android.permission.WRITE_CALENDAR"/>
<!-- خواندن و ثبت رویداد در تقویم گوشی (device_calendar) -->

<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<!-- اعلان یادآوری (اندروید ۱۳+) -->

<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
<!-- زمان‌بندی دقیق هشدارهای هوشمند -->

<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
<!-- زمان‌بندی مجدد اعلان‌ها بعد از ری‌استارت گوشی -->

<uses-permission android:name="android.permission.VIBRATE"/>
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<!-- اعلان‌ها -->

<!-- نکته iOS: معادل این دسترسی‌ها در ios/Runner/Info.plist:
     NSMicrophoneUsageDescription
     NSSpeechRecognitionUsageDescription
     NSCalendarsUsageDescription -->
